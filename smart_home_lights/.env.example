# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# URL of your Home Assistant instance (no trailing slash needed).
# Examples: http://homeassistant.local:8123  |  http://192.168.1.50:8123
HASS_URL=http://homeassistant.local:8123

# Long-lived access token.
# Create one in HA: click your profile (bottom-left) -> Security tab ->
# "Long-lived access tokens" -> Create Token. Copy it here.
HASS_TOKEN=paste-your-long-lived-token-here

# Optional: set to "false" if your HA uses a self-signed HTTPS certificate.
# HASS_VERIFY_SSL=true

# Optional: request timeout in seconds (default 10).
# HASS_TIMEOUT=10
