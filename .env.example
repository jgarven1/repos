# Copy this file to .env and fill in what applies to you.
# .env is gitignored – never commit real credentials.

# --- Google / SSO login ---
# Leave these blank and use --setup mode instead (see README instructions).
# Run once: python3 plaud_transcripts.py --setup
# That opens a real browser so you can log in with Google, then saves the session.

# --- Email / password login (if you don't use Google) ---
PLAUD_EMAIL=you@example.com
PLAUD_PASSWORD=your_password_here

# Directory where exported transcripts are saved (default: ./transcripts)
EXPORT_DIR=transcripts

# Run the browser visibly for debugging (set to "false" to see the browser)
HEADLESS=true

# Export format when the Plaud UI offers a choice: "txt" or "docx"
TRANSCRIPT_FORMAT=txt

# Path to the saved browser session file (created automatically by --setup)
SESSION_FILE=.plaud_session.json
